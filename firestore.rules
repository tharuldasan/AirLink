rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validNewPairing(codeId) {
      return codeId.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'controllerUid', 'memberUids', 'state',
          'createdAt', 'updatedAt', 'expiresAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.controllerUid == null
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids[0] == request.auth.uid
        && request.resource.data.state == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(5, 'm');
    }

    function isPairMember(pairingId) {
      return signedIn()
        && exists(/databases/$(database)/documents/pairings/$(pairingId))
        && request.auth.uid in get(
          /databases/$(database)/documents/pairings/$(pairingId)
        ).data.memberUids;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    // Document IDs are four digits. Codes expire after five minutes and are
    // single-use. Because the free-plan client-only flow has no trusted rate
    // limiter, do not use this design for sensitive accounts or data.
    match /pairings/{codeId} {
      allow get: if signedIn() && (
        request.auth.uid in resource.data.memberUids
        || (resource.data.state == 'pending' && resource.data.expiresAt > request.time)
      );
      allow list: if false;

      allow create: if signedIn() && validNewPairing(codeId);

      // Permit replacing an expired pending code, or a controller joining an
      // unexpired code. No client can add a third member.
      allow update: if signedIn() && (
        (
          resource.data.state == 'pending'
          && resource.data.expiresAt <= request.time
          && validNewPairing(codeId)
        )
        ||
        (
          resource.data.state == 'pending'
          && resource.data.expiresAt > request.time
          && request.auth.uid != resource.data.ownerUid
          && resource.data.memberUids.size() == 1
          && request.resource.data.keys().hasOnly([
            'ownerUid', 'controllerUid', 'memberUids', 'state',
            'createdAt', 'updatedAt', 'expiresAt'
          ])
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.memberUids.size() == 2
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.hasAll([request.auth.uid])
          && request.resource.data.controllerUid == request.auth.uid
          && request.resource.data.state == 'active'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['controllerUid', 'memberUids', 'state', 'updatedAt'])
        )
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
    }

    function isPairedCommand(commandData) {
      return isPairMember(commandData.pairingId)
        && commandData.targetUid in get(
          /databases/$(database)/documents/pairings/$(commandData.pairingId)
        ).data.memberUids;
    }

    match /commands/{commandId} {
      allow read: if signedIn()
        && isPairMember(resource.data.pairingId)
        && resource.data.targetUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'pairingId', 'senderUid', 'targetUid', 'action', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.pairingId is string
        && isPairMember(request.resource.data.pairingId)
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid in get(
          /databases/$(database)/documents/pairings/$(request.resource.data.pairingId)
        ).data.memberUids
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.action in ['airplane_on', 'airplane_off']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && resource.data.targetUid == request.auth.uid
        && isPairMember(resource.data.pairingId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['received', 'completed', 'failed']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
